<script src="~/js/bundle.min.js?v=@DateTime.Now.Ticks"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const wrapper = document.getElementById('rail-profile-wrapper');
        const menu = document.getElementById('rail-profile-menu');
        if (!wrapper || !menu) return;

        let isOpen = false;

        function openMenu() {
            isOpen = true;
            menu.style.display = 'flex';
        }

        function closeMenu() {
            isOpen = false;
            menu.style.display = 'none';
            // Also close submenu if open
            const submenu = document.getElementById('status-submenu');
            if (submenu) submenu.classList.remove('show');
        }

        wrapper.addEventListener('click', (e) => {
            if (isOpen) closeMenu(); else openMenu();
        });

        // Close when clicking outside
        document.addEventListener('click', (e) => {
            if (isOpen && !wrapper.contains(e.target)) {
                closeMenu();
            }
        });
    });

    function toggleStatusMenu(event) {
        event.stopPropagation(); // prevent closing the main menu
        const submenu = document.getElementById('status-submenu');
        if (submenu) {
            submenu.classList.toggle('show');
        }
    }

    function updateStatus(color, text, event) {
        if (event) event.stopPropagation();
        
        const railDot = document.getElementById('rail-status-dot');
        const menuDot = document.getElementById('main-menu-status-dot');
        const menuText = document.getElementById('main-menu-status-text');
        
        if (railDot) railDot.style.backgroundColor = color;
        if (menuDot) menuDot.style.backgroundColor = color;
        if (menuText) menuText.innerText = text;
        
        const submenu = document.getElementById('status-submenu');
        if (submenu) submenu.classList.remove('show');
    }
    
    // DM Context Menu Logic
    window.showDMCtxMenu = function(event, messageId, isMe, isRead, isPinned) {
        event.preventDefault();
        
        let actualIsPinned = isPinned;
        if (window.currentDMMessages && window.currentDMMessages[messageId]) {
            actualIsPinned = window.currentDMMessages[messageId].isPinned;
        }
        
        let dmMenu = document.getElementById('dm-context-menu');
        if (!dmMenu) {
            dmMenu = document.createElement('div');
            dmMenu.id = 'dm-context-menu';
            dmMenu.style.cssText = 'display: none; position: fixed; background: var(--bg-surface-elevated); border: 1px solid var(--border-color); border-radius: var(--radius-md); box-shadow: var(--shadow-md); z-index: 2000; padding: 4px; min-width: 140px;';
            document.body.appendChild(dmMenu);
        }
        
        let menuHtml = `
            <button class="chat-ctx-btn" onclick="handleDMAction('react_full', null, event)"><i class="bi bi-emoji-smile"></i> Tepki Ekle</button>
            <div style="height: 1px; background: var(--border-color); margin: 4px 0;"></div>
        `;
        
        if (isMe) {
            menuHtml += `<button class="chat-ctx-btn" onclick="handleDMAction('edit', null, event)"><i class="bi bi-pencil"></i> Düzenle</button>`;
        }
        
        menuHtml += `
            <button class="chat-ctx-btn" onclick="handleDMAction('reply', null, event)"><i class="bi bi-reply"></i> Yanıtla</button>
            <button class="chat-ctx-btn" onclick="handleDMAction('forward', null, event)"><i class="bi bi-share"></i> İlet</button>
            <div style="height: 1px; background: var(--border-color); margin: 4px 0;"></div>
            <button class="chat-ctx-btn" onclick="handleDMAction('copy', null, event)"><i class="bi bi-copy"></i> Metni Kopyala</button>
            <button class="chat-ctx-btn" onclick="handleDMAction('pin', null, event)"><i class="bi bi-pin${actualIsPinned ? '-fill' : ''}"></i> ${actualIsPinned ? 'Sabitlemeyi Kaldır' : 'Sabitle'}</button>
        `;
        
        if (!isMe) {
            menuHtml += `<button class="chat-ctx-btn" onclick="handleDMAction('markUnread', null, event)"><i class="bi bi-envelope"></i> Okunmadı Olarak İşaretle</button>`;
        }

        
        if (isMe) {
            menuHtml += `<div style="height: 1px; background: var(--border-color); margin: 4px 0;"></div>`;
            menuHtml += `<button class="chat-ctx-btn" style="color: var(--color-danger);" onclick="handleDMAction('delete', null, event)"><i class="bi bi-trash"></i> Sil</button>`;
        }
        
        dmMenu.innerHTML = menuHtml;
        
        // Hide existing menu first
        dmMenu.style.display = 'block';
        
        let x = event.clientX;
        let y = event.clientY;
        
        if (x + dmMenu.offsetWidth > window.innerWidth) x -= dmMenu.offsetWidth;
        if (y + dmMenu.offsetHeight > window.innerHeight) y -= dmMenu.offsetHeight;
        
        dmMenu.style.left = x + 'px';
        dmMenu.style.top = y + 'px';
        
        // Save the current target to know which message we clicked
        dmMenu.dataset.messageId = messageId;
        
        // Persist hover state for the row
        const msgArea = document.getElementById('chat-main-messages');
        if (msgArea) {
            msgArea.classList.add('ctx-open');
            msgArea.querySelectorAll('.chat-message-row.force-hover').forEach(r => r.classList.remove('force-hover'));
        }
        const row = event.target.closest('.chat-message-row');
        if (row) {
            row.classList.add('force-hover');
        }
    };
    
    function clearDMCtxHoverStates() {
        const msgArea = document.getElementById('chat-main-messages');
        if (msgArea) {
            msgArea.classList.remove('ctx-open');
            msgArea.querySelectorAll('.chat-message-row.force-hover').forEach(r => r.classList.remove('force-hover'));
        }
    }
    
    window.handleDMAction = function(action, inlineMessageId, evt) {
        const currentEvent = evt || window.event;
        const dmMenu = document.getElementById('dm-context-menu');
        
        if (action !== 'react_full' && action !== 'react') {
            if (dmMenu) dmMenu.style.display = 'none';
            clearDMCtxHoverStates();
        } else {
            if (currentEvent) {
                currentEvent.stopPropagation();
            }
        }
        
        const messageId = inlineMessageId || (dmMenu ? dmMenu.dataset.messageId : null);
        if (!messageId) return;
        
        if (action === 'reply') {
            if (window.startDMReply) window.startDMReply(messageId);
        } else if (action === 'forward') {
            if (window.openDMForwardPanel) window.openDMForwardPanel(messageId);
        } else if (action === 'edit') {
            if (window.startDMEdit) window.startDMEdit(messageId);
        } else if (action === 'delete') {
            if (window.deleteDMMessage) window.deleteDMMessage(messageId);
        } else if (action === 'copy') {
            const msg = window.currentDMMessages ? window.currentDMMessages[messageId] : null;
            if (msg && msg.content) {
                navigator.clipboard.writeText(msg.content).then(() => {
                    if (window.showToast) window.showToast("Metin panoya kopyalandı.", "success");
                }).catch(err => {
                    console.error('Kopyalama hatası:', err);
                    if (window.showToast) window.showToast("Metin kopyalanamadı.", "danger");
                });
            } else {
                if (window.showToast) window.showToast("Kopyalanacak metin bulunamadı.", "warning");
            }
        } else if (action === 'markUnread') {
            fetch('/api/ChatApi/messages/' + messageId + '/mark-unread', {
                method: 'POST'
            }).then(r => {
                if(r.ok) {
                    if (window.showToast) window.showToast("Mesaj okunmadı olarak işaretlendi", "success");
                    
                    if (typeof activeChatSessionId !== 'undefined' && activeChatSessionId) {
                        const timeSpan = document.querySelector('span[data-message-id="' + messageId + '"]');
                        if (timeSpan) {
                            const row = timeSpan.closest('.chat-message-row');
                            if (row) {
                                // Remove old dividers
                                document.querySelectorAll('#chat-main-messages .chat-unread-divider').forEach(el => el.remove());
                                
                                // Count unread messages
                                const allRows = Array.from(document.querySelectorAll('#chat-main-messages .chat-message-row'));
                                const rowIndex = allRows.indexOf(row);
                                const unreadCount = rowIndex >= 0 ? (allRows.length - rowIndex) : 1;
                                
                                // Insert divider
                                const dividerHtml = `
                                    <div class="chat-unread-divider" style="display: flex; align-items: center; text-align: center; margin: 16px 24px 8px 24px; color: var(--color-danger); font-size: 0.75rem; font-weight: 500; user-select: none;">
                                        <div style="flex: 1; border-bottom: 1px solid var(--color-danger);"></div>
                                        <span style="padding: 0 12px;">${unreadCount} okunmamış ileti</span>
                                        <div style="flex: 1; border-bottom: 1px solid var(--color-danger);"></div>
                                    </div>
                                `;
                                row.insertAdjacentHTML('beforebegin', dividerHtml);
                                
                                // Un-group this row if it was grouped
                                row.style.marginTop = '24px';
                                
                                const divider = document.querySelector('#chat-main-messages .chat-unread-divider');
                                if (divider) divider.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                
                                if (!window.unreadChatCounts) window.unreadChatCounts = {};
                                window.unreadChatCounts[activeChatSessionId] = unreadCount;
                                if (typeof updateRailBadge === 'function') updateRailBadge();
                            }
                        }
                    }
                    
                    if (typeof loadChatSessions === 'function') loadChatSessions();
                } else {
                    if (window.showToast) window.showToast("İşlem başarısız.", "danger");
                }
            }).catch(e => console.error(e));
        } else if (action === 'react') {
            if (window.openEmojiPicker) {
                window.openEmojiPicker(messageId, currentEvent);
            }
            if (typeof clearUnreadState === 'function') clearUnreadState(activeChatSessionId);
        } else if (action === 'react_full') {
            if (window.openFullEmojiPicker) {
                window.openFullEmojiPicker(messageId, currentEvent);
            }
            if (typeof clearUnreadState === 'function') clearUnreadState(activeChatSessionId);
        } else if (action === 'pin') {
            fetch('/api/ChatApi/messages/' + messageId + '/pin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(r => r.json()).then(res => {
                if(window.handleMessagePinnedToggled) window.handleMessagePinnedToggled(messageId, res.isPinned);
            }).catch(e => console.error(e));
        } else {
            console.log("DM Action Triggered:", action, "on Message ID:", messageId);
        }
    };
    
    document.addEventListener('click', (e) => {
        const dmMenu = document.getElementById('dm-context-menu');
        if (dmMenu && dmMenu.style.display === 'block') {
            const bigPicker = document.getElementById('chat-emoji-picker');
            const reactionPicker = document.getElementById('chat-reaction-picker');
            
            if ((bigPicker && bigPicker.style.display === 'flex' && bigPicker.contains(e.target)) || 
                (reactionPicker && reactionPicker.contains(e.target))) {
                return; // Do not close context menu if clicking inside emoji pickers
            }
            
            dmMenu.style.display = 'none';
            clearDMCtxHoverStates();
        }
        const sessionMenu = document.getElementById('chat-session-context-menu');
        if (sessionMenu && sessionMenu.style.display === 'block') {
            sessionMenu.style.display = 'none';
        }
    });

    document.addEventListener('contextmenu', (e) => {
        // If they right click outside any message row, clear the custom states.
        // showDMCtxMenu will override this if they right-clicked on another row.
        if (!e.target.closest('.chat-message-row')) {
            const dmMenu = document.getElementById('dm-context-menu');
            if (dmMenu && dmMenu.style.display === 'block') {
                dmMenu.style.display = 'none';
                clearDMCtxHoverStates();
            }
        }
    });
    
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const dmMenu = document.getElementById('dm-context-menu');
            if (dmMenu && dmMenu.style.display === 'block') {
                dmMenu.style.display = 'none';
                clearDMCtxHoverStates();
            }
            
            const sessionMenu = document.getElementById('chat-session-context-menu');
            if (sessionMenu && sessionMenu.style.display === 'block') {
                sessionMenu.style.display = 'none';
            }
        }
    });
    
    window.showChatSessionCtxMenu = function(event, sessionId, type, otherUsername) {
        event.preventDefault();
        
        let sessionMenu = document.getElementById('chat-session-context-menu');
        if (!sessionMenu) {
            sessionMenu = document.createElement('div');
            sessionMenu.id = 'chat-session-context-menu';
            sessionMenu.style.cssText = 'display: none; position: fixed; background: var(--bg-surface-elevated); border: 1px solid var(--border-color); border-radius: var(--radius-md); box-shadow: var(--shadow-md); z-index: 2000; padding: 4px; min-width: 160px;';
            document.body.appendChild(sessionMenu);
        }
        
        let html = '';
        if (type === 1 && otherUsername) {
            html += `<button class="chat-ctx-btn" onclick="window.location.href='/Personal/User/${otherUsername}'"><i class="bi bi-person"></i> Profili Görüntüle</button>`;
        }
        
        let session = (typeof currentChatSessions !== 'undefined') ? currentChatSessions.find(s => s.id === sessionId) : null;
        let isPinned = session ? session.isPinned : false;
        let isMuted = session ? session.isMuted : false;
        
        if (isMuted) {
            html += `<button class="chat-ctx-btn" onclick="handleChatSessionAction('mute', ${sessionId})"><i class="bi bi-bell"></i> Sesi Aç</button>`;
        } else {
            html += `<button class="chat-ctx-btn" onclick="handleChatSessionAction('mute', ${sessionId})"><i class="bi bi-bell-slash"></i> Sessize Al</button>`;
        }
        
        if (isPinned) {
            html += `<button class="chat-ctx-btn" onclick="handleChatSessionAction('pin', ${sessionId})"><i class="bi bi-pin-angle-fill"></i> Sabitlemeyi Kaldır</button>`;
        } else {
            html += `<button class="chat-ctx-btn" onclick="handleChatSessionAction('pin', ${sessionId})"><i class="bi bi-pin-angle"></i> Sabitle</button>`;
        }
        
        html += `<div style="height: 1px; background: var(--border-color); margin: 4px 0;"></div>`;
        if (type === 1) {
            html += `<button class="chat-ctx-btn" style="color: var(--color-danger);" onclick="handleChatSessionAction('delete', ${sessionId})"><i class="bi bi-trash"></i> Sohbeti Sil</button>`;
        } else {
            html += `<button class="chat-ctx-btn" style="color: var(--color-danger);" onclick="handleChatSessionAction('leave', ${sessionId})"><i class="bi bi-box-arrow-right"></i> Gruptan Çık</button>`;
        }
        
        sessionMenu.innerHTML = html;
        sessionMenu.dataset.sessionId = sessionId;
        
        sessionMenu.style.display = 'block';
        
        let x = event.clientX;
        let y = event.clientY;
        
        const rect = sessionMenu.getBoundingClientRect();
        if (x + rect.width > window.innerWidth) x -= rect.width;
        if (y + rect.height > window.innerHeight) y -= rect.height;
        
        sessionMenu.style.left = x + 'px';
        sessionMenu.style.top = y + 'px';
    };
    
    window.handleChatSessionAction = async function(action, sessionId) {
        const sessionMenu = document.getElementById('chat-session-context-menu');
        if (sessionMenu) sessionMenu.style.display = 'none';
        
        let endpointAction = action;
        if (action === 'delete') endpointAction = 'hide';

        try {
            const res = await fetch(`/api/ChatApi/${sessionId}/${endpointAction}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            if (res.ok) {
                if (action === 'delete' || action === 'leave') {
                    if (window.activeChatSessionId === sessionId) {
                        window.activeChatSessionId = null;
                        document.getElementById('chat-messages').innerHTML = '';
                        document.getElementById('chat-header-title').textContent = 'Sohbet Seçin';
                        document.getElementById('chat-header-status').textContent = '';
                        document.getElementById('chat-header-avatar').style.display = 'none';
                    }
                }
                if (window.loadChatSessions) {
                    window.loadChatSessions();
                }
            } else {
                if (typeof showToast === 'function') showToast("İşlem başarısız oldu.", "danger");
            }
        } catch(e) {
            console.error("Action error:", e);
        }
    };
</script>
