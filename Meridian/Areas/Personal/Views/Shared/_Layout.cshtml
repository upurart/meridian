<div class="tm-modal-overlay" id="spotlight-modal" style="display: none; align-items: flex-start; padding-top: 15vh; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(2px); z-index: 9999;">
    <div style="width: 100%; max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px;">
        
        <div style="display: flex; align-items: center; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 50px; padding: 4px 12px; width: 100%; box-shadow: var(--shadow-lg);">
            <input id="spotlight-input" type="text" autocomplete="off" placeholder="Meridian'da ara veya komut yazın..." style="flex: 1; border: none; background: transparent; padding: 12px 16px; outline: none; color: var(--text-primary); font-size: 1.05rem;" />
            
            <div style="height: 24px; width: 1px; background-color: var(--border-color); margin: 0 12px;"></div>
            
            <div style="position: relative; display: flex; align-items: center;">
                <select id="spotlight-search-filter" style="border: none; background: transparent; outline: none; color: var(--text-secondary); font-size: 0.95rem; font-weight: 500; padding: 8px 28px 8px 12px; cursor: pointer; appearance: none; -webkit-appearance: none; z-index: 1;">
                    <option value="all">Tümü</option>
                    <option value="workspaces">Çalışma Alanları</option>
                    <option value="projects">Projeler</option>
                    <option value="teams">Takımlar</option>
                </select>
