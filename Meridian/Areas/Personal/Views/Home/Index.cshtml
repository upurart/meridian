@using Meridian.Models
@using Meridian.Infrastructure.Persistence
@inject AppDbContext _context
@{
ViewData["Title"] = "Dashboard";
}

<div id="home-view" style="display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; padding: 16px 24px 0 24px; margin-top: 0;">
    <script>
        window.currentUserGivenName = "@Html.Raw(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "")";
    </script>
    <h1 id="home-greeting-msg" style="font-family: 'Funnel Display', sans-serif; font-size: 2.2rem; font-weight: 500; color: var(--text-primary); text-align: center; margin-top: 18vh; margin-bottom: 40px;"></h1>
    
    <style>
        .cmd-suggestion-item {
            padding: 10px 16px;
            cursor: pointer;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 12px;
            transition: background 0.2s;
        }
        .cmd-suggestion-item:hover {
            background: var(--bg-modifier-hover);
        }
        .cmd-suggestion-item.active {
            background: rgba(128, 128, 128, 0.2); /* Daha belirgin ve koyu bir arkaplan */
        }
        .cmd-suggestion-item i {
            color: var(--text-muted);
            font-size: 1.1rem;
        }
        .cmd-suggestion-item .cmd-name {
            font-weight: 600;
            font-family: monospace;
            background: var(--bg-modifier-active);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.9rem;
        }
        .cmd-suggestion-item .cmd-desc {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        .fm-grid-item {
            user-select: none;
            -webkit-user-select: none;
        }
    </style>
    <div style="display: flex; justify-content: center; width: 100%; margin-bottom: 16px;">
        <div style="position: relative; width: 100%; max-width: 680px;">
            <div class="home-search-container" id="home-search-container" style="display: flex; align-items: center; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 50px; padding: 4px 12px; width: 100%; box-shadow: var(--shadow-sm); transition: box-shadow 0.2s, border-color 0.2s;" onmouseover="this.style.boxShadow='var(--shadow-md)'" onmouseout="if(!this.classList.contains('focused')) this.style.boxShadow='var(--shadow-sm)'">
                <input id="home-search-input" type="text" autocomplete="off" placeholder="Meridian'da bir şeyler arayın..." style="flex: 1; border: none; background: transparent; padding: 12px 16px; outline: none; color: var(--text-primary); font-size: 1.05rem;" onfocus="this.parentElement.classList.add('focused'); this.parentElement.style.borderColor='var(--color-primary)'; this.parentElement.style.boxShadow='var(--shadow-md)'; const rc = document.getElementById('recent-projects-container'); rc.style.display='block'; void rc.offsetWidth; rc.style.opacity='1'; window.handleHomeSearch(this.value, true);" oninput="window.handleHomeSearch(this.value);" onblur="const rc = document.getElementById('recent-projects-container'); rc.style.opacity='0'; setTimeout(() => { this.parentElement.classList.remove('focused'); this.parentElement.style.borderColor='var(--border-color)'; this.parentElement.style.boxShadow='var(--shadow-sm)'; rc.style.display='none'; }, 300);" onkeydown="if (typeof window.handleHomeSearchKeydown === 'function') window.handleHomeSearchKeydown(event);">
                
                <div style="height: 24px; width: 1px; background-color: var(--border-color); margin: 0 12px;"></div>
                
                <div style="position: relative; display: flex; align-items: center;">
                    <select id="home-search-filter" onchange="window.handleHomeSearch(document.getElementById('home-search-input').value);" style="border: none; background: transparent; outline: none; color: var(--text-secondary); font-size: 0.95rem; font-weight: 500; padding: 8px 28px 8px 12px; cursor: pointer; appearance: none; -webkit-appearance: none; z-index: 1;">
                        <option value="all">Tümü</option>
                        <option value="workspaces">Çalışma Alanları</option>
                        <option value="projects">Projeler</option>
                        <option value="teams">Takımlar</option>
                    </select>
                    <i class="bi bi-chevron-down" style="position: absolute; right: 10px; pointer-events: none; color: var(--text-muted); font-size: 0.8rem; z-index: 0;"></i>
                </div>
                
                <button style="background: transparent; color: var(--text-muted); border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; cursor: pointer; margin-left: 4px; transition: color 0.2s;" onmouseover="this.style.color='white'" onmouseout="this.style.color='var(--text-muted)'">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            
            <!-- Command Suggestions Dropdown -->
            <div id="command-suggestions-dropdown" style="display: none; position: absolute; top: 100%; left: 0; width: 100%; margin-top: 8px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); box-shadow: var(--shadow-lg); z-index: 100; overflow: hidden; flex-direction: column;">
                <!-- Suggestions will be injected here via JS -->
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: center; gap: 24px; width: 100%; margin-bottom: 16px;">
        <button onclick="openModal('create-workspace-modal')" style="background: transparent; border: none; color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: color 0.2s;" onmouseover="this.style.color='var(--text-primary)'" onmouseout="this.style.color='var(--text-secondary)'">
            <i class="bi bi-plus-lg" style="font-size: 0.95rem;"></i> Yeni Çalışma Alanı
        </button>
        <button onclick="openProjectModal()" style="background: transparent; border: none; color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: color 0.2s;" onmouseover="this.style.color='var(--text-primary)'" onmouseout="this.style.color='var(--text-secondary)'">
            <i class="bi bi-plus-lg" style="font-size: 0.95rem;"></i> Yeni Proje
        </button>
        <button onclick="openModal('create-team-modal')" style="background: transparent; border: none; color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: color 0.2s;" onmouseover="this.style.color='var(--text-primary)'" onmouseout="this.style.color='var(--text-secondary)'">
            <i class="bi bi-plus-lg" style="font-size: 0.95rem;"></i> Yeni Takım
        </button>
    </div>

    <!-- Son Çalışılan Projeler Grid Bölümü -->
    <div id="recent-projects-container" style="display: none; opacity: 0; transition: opacity 0.3s ease; width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px;">
        <div style="text-align: center; margin-bottom: 24px; margin-top: 64px;">
            <div id="recent-projects-title" style="font-family: 'Funnel Display', sans-serif; font-size: 1.15rem; font-weight: 500; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">Son Çalışılan Projeler</div>
            <div style="height: 1px; width: 100%; background: linear-gradient(to right, transparent, var(--border-color), transparent);"></div>
        </div>
        <div id="recent-projects-grid" style="display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; padding-bottom: 32px;">
            <div style="color: var(--text-muted); font-size: 0.9rem; grid-column: span 5; text-align: center;">Yükleniyor...</div>
        </div>
    </div>
</div>

<div id="calendar-view" style="display: none; flex-direction: column; align-items: stretch; justify-content: stretch; padding: 0; height: 100%; margin: 0;">
    <div id="planner-calendar" style="flex: 1; min-height: 0; background: transparent; padding: 0; margin: 0;"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (typeof updateGreeting === "function") {
            updateGreeting();
        }
    });
</script>

<div id="workspaces-dashboard-view" style="display: none;">

    <div class="page-header">
        <div>
            <h2 class="page-title">
                <i class="bi bi-folder2-open" style="color: var(--color-primary);"></i> <span id="home-view-title">Kişisel Çalışma Alanları</span>
            </h2>
            <p id="home-view-subtitle" class="page-subtitle">
                Kişisel çalışma alanlarınızı ve projelerinizi buradan yönetin.
            </p>
        </div>
        <div style="display: flex; gap: 8px;">
            <button class="tm-btn tm-btn-success" id="btn-create-workspace-home" onclick="openModal('create-workspace-modal')">+ Yeni Çalışma Alanı</button>
            <button class="tm-btn tm-btn-secondary" id="btn-join-project-home" style="display:none;" onclick="openJoinProjectModal()">Katıl</button>
            <button class="tm-btn tm-btn-success" id="btn-create-project-home" style="display:none;" onclick="openProjectModal()">+ Yeni Proje</button>
        </div>
    </div>

    <!-- Search and Filter Bar for Workspaces Grid -->
    <div id="home-filters-bar" class="tm-card" style="margin-bottom: 24px; padding: 12px 16px; border: 1px solid var(--border-color); background-color: var(--bg-surface); display: flex; flex-wrap: nowrap; overflow-x: auto; gap: 16px; align-items: center; justify-content: space-between; border-radius: var(--radius-md);">
        <div style="flex: 1; min-width: 200px; position: relative;">
            <input type="text" id="grid-search" placeholder="Çalışma alanı ara..." class="form-control" style="box-sizing: border-box; padding-left: 36px; font-size: 0.9rem; height: 42px; margin: 0;" />
            <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
        </div>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: nowrap;">
            <div id="project-filters-group" style="display: none; flex-wrap: nowrap; gap: 8px; align-items: center;">
                <select id="grid-sort" class="form-control" style="box-sizing: border-box; font-size: 0.9rem; padding: 0 12px; min-width: 180px; height: 42px; margin: 0;">
                    <option value="none">Sıralama Yok</option>
                    <option value="closest-deadline">En Yakın Teslim</option>
                    <option value="farthest-deadline">En uzak teslim</option>
                    <option value="highest-completion">En yüksek tamamlama oranı</option>
                    <option value="lowest-completion">En düşük tamamlama oranı</option>
                </select>
                <select id="grid-filter-status" class="form-control" style="box-sizing: border-box; font-size: 0.9rem; padding: 0 12px; min-width: 200px; height: 42px; margin: 0;">
                    <option value="all">Tüm Projeler</option>
                    <option value="active">Sadece Aktif Projeler</option>
                    <option value="completed">Sadece Tamamlanan Projeler</option>
                    <option value="approaching">Yaklaşan Teslimler</option>
                    <option value="overdue">Geciken Projeler</option>
                </select>
                <button id="btn-clear-filters" class="tm-btn tm-btn-secondary" disabled title="Filtreleri Temizle" style="box-sizing: border-box; padding: 0 16px; font-size: 0.9rem; height: 42px; margin: 0; display: flex; align-items: center; justify-content: center;">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8 21l-3.5 -3.5a1.82 1.82 0 0 1 .1 -2.65l5.4 -5.4l4.1 4.1l-5.4 5.4a1.82 1.82 0 0 1 -2.65 .1z"></path>
                        <path d="M14 10l5.5 -5.5a1 1 0 0 0 -1.4 -1.4l-5.5 5.5"></path>
                        <path d="M9 15l-1.5 1.5"></path>
                    </svg>
                </button>
                
                <div style="width: 1px; background-color: var(--border-color); height: 42px; margin: 0 4px;"></div>
            </div>
            
            <div style="display: flex; gap: 4px; align-items: center; background-color: var(--bg-body); padding: 4px; border-radius: var(--radius-md); border: 1px solid var(--border-color); height: 42px; box-sizing: border-box;">
                <button id="btn-view-grid" class="tm-btn-icon-only active" title="Varsayılan Kart Görünümü" style="padding: 6px 10px;" onclick="setProjectViewMode('grid')"><i class="bi bi-grid"></i></button>
                <button id="btn-view-list" class="tm-btn-icon-only" title="Liste Görünümü" style="padding: 6px 10px;" onclick="setProjectViewMode('list')"><i class="bi bi-list-task"></i></button>
                <button id="btn-view-compact" class="tm-btn-icon-only" title="Kompakt Görünüm" style="padding: 6px 10px;" onclick="setProjectViewMode('compact')"><i class="bi bi-list"></i></button>
            </div>
        </div>
    </div>

    <div id="projects-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
    </div>
</div>

<div id="workspace-projects-view" style="display: none;">
    <div class="page-header" style="border-bottom: 1px solid var(--border-color); padding-bottom: 20px; margin-bottom: 24px;">

        <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;">
            <div>
                <h2 style="font-size: 1.4rem; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-briefcase" style="color: var(--color-primary);"></i> <span id="ws-detail-title">Çalışma Alanı</span>
                    <button class="btn btn-icon btn-sm" onclick="openWorkspaceSettingsModal()" title="Ayarlar" style="margin-left: 10px; color: var(--text-secondary);">
                        <i class="bi bi-gear"></i>
                    </button>
                </h2>
                <p class="page-subtitle" id="ws-detail-desc" style="max-width: 600px;">
                    Açıklama yükleniyor...
                </p>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
                <span id="ws-detail-role" class="badge" style="background-color: var(--bg-surface-elevated); color: var(--text-secondary); font-size: 0.85rem; padding: 6px 12px;">Rol Yükleniyor</span>
                <button class="tm-btn tm-btn-success" onclick="openProjectModal()">+ Yeni Proje</button>
            </div>
        </div>
    </div>

    <!-- Workspace Statistics -->
    <div class="stats-grid" style="margin-bottom: 24px;">
        <div class="stat-card stat-success" id="stat-card-productivity">
            <span class="stat-title">HAFTALIK TAMAMLANAN GÖREV</span>
            <span class="stat-value" id="stat-weekly-productivity">0</span>
        </div>
        <div class="stat-card stat-danger" id="stat-card-approaching">
            <span class="stat-title">YAKLAŞAN TESLİMLER</span>
            <span class="stat-value" id="stat-approaching-deadlines" style="font-size: 1.5rem; word-break: break-word;">-</span>
        </div>
        <div class="stat-card stat-error" id="stat-card-overdue">
            <span class="stat-title">GECİKEN PROJELER</span>
            <span class="stat-value" id="stat-overdue-projects" style="font-size: 1.5rem; word-break: break-word;">0</span>
        </div>
    </div>

    <!-- Filtreleme (Projeler için) -->
    <div class="tm-card" style="margin-bottom: 24px; padding: 12px 16px; border: 1px solid var(--border-color); background-color: var(--bg-surface); display: flex; flex-wrap: nowrap; overflow-x: auto; gap: 16px; align-items: center; justify-content: space-between; border-radius: var(--radius-md);">
        <div style="flex: 1; min-width: 200px; position: relative;">
            <input type="text" id="ws-project-search" placeholder="Proje ara..." class="form-control" style="box-sizing: border-box; padding-left: 36px; font-size: 0.9rem; height: 42px; margin: 0;" />
            <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
        </div>
        
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: nowrap;">
            <select id="ws-grid-sort-status" class="form-control" style="box-sizing: border-box; font-size: 0.9rem; padding: 0 12px; min-width: 180px; height: 42px; margin: 0;">
                <option value="none">Sıralama: Varsayılan</option>
                <option value="closest-deadline">En yakın teslim tarihi</option>
                <option value="farthest-deadline">En uzak teslim tarihi</option>
                <option value="highest-completion">En yüksek tamamlama oranı</option>
                <option value="lowest-completion">En düşük tamamlama oranı</option>
            </select>
            <select id="ws-grid-filter-status" class="form-control" style="box-sizing: border-box; font-size: 0.9rem; padding: 0 12px; min-width: 200px; height: 42px; margin: 0;">
                <option value="all">Tüm Projeler</option>
                <option value="active">Sadece Aktif Projeler</option>
                <option value="completed">Sadece Tamamlanan Projeler</option>
                <option value="approaching">Yaklaşan Teslimler</option>
                <option value="overdue">Geciken Projeler</option>
            </select>
            <button id="ws-btn-clear-filters" class="tm-btn tm-btn-secondary" disabled title="Filtreleri Temizle" style="box-sizing: border-box; padding: 0 16px; font-size: 0.9rem; height: 42px; margin: 0; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 21l-3.5 -3.5a1.82 1.82 0 0 1 .1 -2.65l5.4 -5.4l4.1 4.1l-5.4 5.4a1.82 1.82 0 0 1 -2.65 .1z"></path>
                    <path d="M14 10l5.5 -5.5a1 1 0 0 0 -1.4 -1.4l-5.5 5.5"></path>
                    <path d="M9 15l-1.5 1.5"></path>
                </svg>
            </button>
            
            <div style="width: 1px; background-color: var(--border-color); height: 42px; margin: 0 4px;"></div>
            
            <div style="display: flex; gap: 4px; align-items: center; background-color: var(--bg-body); padding: 4px; border-radius: var(--radius-md); border: 1px solid var(--border-color); height: 42px; box-sizing: border-box;">
                <button id="ws-btn-view-grid" class="tm-btn-icon-only active" title="Kart Görünümü" style="padding: 6px 10px;" onclick="setWsProjectViewMode('grid')"><i class="bi bi-grid"></i></button>
                <button id="ws-btn-view-list" class="tm-btn-icon-only" title="Liste Görünümü" style="padding: 6px 10px;" onclick="setWsProjectViewMode('list')"><i class="bi bi-list-task"></i></button>
                <button id="ws-btn-view-compact" class="tm-btn-icon-only" title="Kompakt Görünüm" style="padding: 6px 10px;" onclick="setWsProjectViewMode('compact')"><i class="bi bi-list"></i></button>
            </div>
        </div>
    </div>

    <div id="ws-projects-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        <!-- Projeler buraya yüklenecek -->
    </div>
</div>

<div id="teams-dashboard-view" style="display: none;">
    <div class="page-header">
        <div>
            <h2 class="page-title">
                <i class="bi bi-people" style="color: var(--color-primary);"></i> <span>Takımlar</span>
            </h2>
            <p class="page-subtitle">
                Bulunduğunuz takımları yönetin veya yeni bir takıma katılın.
            </p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="tm-btn tm-btn-secondary" onclick="openJoinTeamModal()">+ Takıma Katıl</button>
            <button class="tm-btn tm-btn-primary" onclick="openCreateTeamModal()">+ Yeni Takım Kur</button>
        </div>
    </div>

    <div id="teams-dashboard-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        <!-- Takımlar buraya yüklenecek -->
    </div>
</div>

<div id="workspace-view" style="display: none;">
    <div class="page-header" style="border-bottom: 1px solid var(--border-color); padding-bottom: 20px; margin-bottom: 24px;">

        <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;">
            <div>
                <h2 id="wp-title" class="page-title" style="margin-bottom: 8px;">Proje Yükleniyor...</h2>
                <p id="wp-desc" class="page-subtitle" style="max-width: 800px; margin-bottom: 8px;"></p>
                <div id="wp-dates" style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 16px; display: flex; gap: 16px; align-items: center;"></div>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="tm-btn tm-btn-secondary" id="wp-edit-btn">Düzenle</button>
                <button class="tm-btn tm-btn-danger" id="wp-delete-btn">Sil</button>
                <button class="tm-btn tm-btn-success" id="wp-add-new-item-btn" onclick="openUnifiedAddModal()"><i class="bi bi-plus"></i> Ekle</button>
            </div>
        </div>
    </div>


        <div class="progress-container">
            <div class="progress-header">
                <span>Genel Proje İlerlemesi</span>
                <span id="wp-progress-text" style="font-weight: 600;">%0</span>
            </div>
            <div class="progress-bar-bg" style="height: 12px; border-radius: 6px;">
                <div class="progress-bar-fill" id="wp-progress-bar" style="width: 0%;"></div>
            </div>
        </div>

    <!-- Workspace Tabs -->
    <div class="workspace-tabs" style="display: flex; gap: 16px; margin-top: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 4px;">
        <button id="tab-active-goals" class="workspace-tab-btn active-tab" onclick="switchWorkspaceTab('active')" style="background: none; border: none; border-bottom: 3px solid var(--color-primary); color: var(--text-primary); font-weight: 600; font-size: 0.95rem; cursor: pointer; padding: 8px 16px; transition: all 0.2s;">
            <i class="bi bi-pin"></i> Aktif Hedefler
        </button>
        <button id="tab-deleted-goals" class="workspace-tab-btn" onclick="switchWorkspaceTab('deleted')" style="background: none; border: none; border-bottom: 3px solid transparent; color: var(--text-secondary); font-weight: 500; font-size: 0.95rem; cursor: pointer; padding: 8px 16px; transition: all 0.2s;">
            <i class="bi bi-trash3"></i> Silinen Ögeler
        </button>
    </div>

    <!-- Tab Contents -->
    <div id="active-tab-content" style="display: block;">
        <div id="maingoals-list" style="margin-top: 32px;">
        </div>
    </div>

    <div id="deleted-tab-content" style="display: none; margin-top: 32px;">
        <div id="deleted-items-list" class="deleted-items-list" style="display: flex; flex-direction: column; gap: 16px;">
            <!-- Silinen ögeler buraya yüklenecek -->
        </div>
    </div>
</div>

<div id="deleted-view" style="display: none;">
    <div class="page-header">
        <div>
            <h2 class="page-title">
                <i class="bi bi-trash3" style="color: var(--color-danger);"></i> <span>Çöp Kutusu</span>
            </h2>
            <p class="page-subtitle">
                Silinen projelerinizi buradan inceleyebilir, geri yükleyebilir veya kalıcı olarak silebilirsiniz.
            </p>
        </div>
        <button class="tm-btn tm-btn-secondary" onclick="showDashboardHome()">← Panoya Geri Dön</button>
    </div>

    <!-- Bulk Operations Toolbar -->
    <div id="trash-bulk-toolbar" style="display: none; justify-content: space-between; align-items: center; background-color: var(--bg-surface-elevated); padding: 12px 20px; border-radius: var(--radius-md); margin-bottom: 20px; border: 1px solid var(--border-color); flex-wrap: wrap; gap: 12px;">
