                    Dosyaları Buraya Bırakın
                </div>
            </div>
            <div id="fm-upload-overlay" style="display: none; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.4); z-index: 105; align-items: center; justify-content: center; border-radius: 8px; backdrop-filter: blur(2px);">
                <div style="background: var(--bg-surface-elevated); padding: 16px 32px; border-radius: 12px; font-weight: 500; color: var(--text-primary); box-shadow: var(--shadow-lg); display: flex; align-items: center; gap: 12px;">
