<!-- File Manager Image Preview Modal -->
<div class="tm-modal-overlay" id="fm-image-modal" style="display: none; align-items: center; justify-content: center; background-color: rgba(0,0,0,0.85); z-index: 1050; padding: 40px; position: fixed; inset: 0;" onclick="if(event.target === this) { this.classList.remove('active'); setTimeout(() => this.style.display='none', 200); }">
    <div style="position: relative; max-width: 90%; max-height: 90%; display: flex; flex-direction: column; align-items: center;">
        <button style="position: absolute; top: -40px; right: -40px; color: white; background: none; border: none; font-size: 2rem; cursor: pointer;" onclick="const m = document.getElementById('fm-image-modal'); m.classList.remove('active'); setTimeout(() => m.style.display='none', 200);"><i class="bi bi-x"></i></button>
        <img id="fm-image-modal-img" src="" style="max-width: 100%; max-height: calc(100vh - 120px); object-fit: contain; border-radius: 4px; box-shadow: 0 8px 24px rgba(0,0,0,0.5);" />
    </div>
</div>

