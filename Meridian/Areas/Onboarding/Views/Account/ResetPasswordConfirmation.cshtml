@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meridian - Şifre Sıfırlandı</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-container">
        <div class="auth-card" style="text-align: center;">
            <div class="auth-logo">Meridian</div>
            <h3 style="color: var(--color-success); margin-bottom: 16px;">Şifreniz Sıfırlandı!</h3>
            <p style="color: var(--text-secondary); margin-bottom: 24px;">
                Şifreniz başarıyla değiştirildi. Artık yeni şifrenizle giriş yapabilirsiniz.
            </p>
            
            <a asp-action="Login" class="tm-btn tm-btn-primary" style="text-decoration: none; display: inline-block;">Giriş Yap</a>
        </div>
    </div>
</body>
</html>
