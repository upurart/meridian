@model IEnumerable<TaskManagerApp.Models.SubGoal>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="margin: 0; color: var(--text-main);">Alt Hedefler</h2>
    <a asp-action="Create" asp-route-mainGoalId="@ViewBag.MainGoalId" class="tm-btn tm-btn-success">+ Yeni Alt Hedef Ekle</a>
</div>

<div class="row">
    @foreach (var subGoal in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="tm-card">
                <h3>@subGoal.Title</h3>
                <p>@subGoal.Description</p>

                <div class="tm-actions" style="margin-top: 20px;">
                    <a asp-controller="TaskItem" asp-action="Index" asp-route-subGoalId="@subGoal.Id" class="tm-btn tm-btn-success" style="flex: 1;">Görevleri Gör</a>
                    <a asp-action="Edit" asp-route-id="@subGoal.Id" class="tm-btn tm-btn-warning">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@subGoal.Id" class="tm-btn tm-btn-danger">Sil</a>
                </div>
            </div>
        </div>
    }
</div>

<div style="margin-top: 20px;">
    <a asp-controller="Project" asp-action="Index" class="tm-btn" style="background-color: #333; color: var(--text-main);">Tüm Projelere Geri Dön</a>
</div>