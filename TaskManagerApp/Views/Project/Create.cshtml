@model TaskManagerApp.Models.Project

<h2>Yeni Proje Oluştur</h2>

<form asp-action="Create" method="post">
    <div style="margin-bottom: 15px;">
        <label asp-for="Title" style="font-weight: bold;">Proje Başlığı</label>
        <input asp-for="Title" style="width: 100%; padding: 8px;" />
        <span asp-validation-for="Title" style="color: red;"></span>
    </div>
    
    <div style="margin-bottom: 15px;">
        <label asp-for="Description" style="font-weight: bold;">Açıklama</label>
        <textarea asp-for="Description" style="width: 100%; padding: 8px; height: 100px;"></textarea>
        <span asp-validation-for="Description" style="color: red;"></span>
    </div>

    <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; cursor: pointer;">
        Projeyi Kaydet
    </button>
</form>

<div style="margin-top: 15px;">
    <a asp-action="Index">Listeye Geri Dön</a>
</div>