@model IEnumerable<TaskManagerApp.Models.Project>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="margin: 0; color: var(--text-main);">Projelerim</h2>
    <a asp-action="Create" class="tm-btn tm-btn-success">+ Yeni Proje Ekle</a>
</div>

<div class="row">
    @foreach (var project in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="tm-card">
                <h3>@project.Title</h3>
                <p>@project.Description</p>

                <div class="tm-actions" style="margin-top: 20px;">
                    <a asp-controller="MainGoal" asp-action="Index" asp-route-projectId="@project.Id" class="tm-btn tm-btn-success" style="flex: 1;">Hedefleri Gör</a>
                    <a asp-action="Edit" asp-route-id="@project.Id" class="tm-btn tm-btn-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@project.Id" class="tm-btn tm-btn-danger">Sil</a>
                </div>
            </div>
        </div>
    }
</div>