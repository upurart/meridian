    <button id="chat-context-delete" class="chat-ctx-btn" style="color: #ff4d4f;" onclick="handleChatAction('delete')"><i class="bi bi-trash"></i> Sil</button>
</div>

<style>
    .chat-ctx-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 12px;
