@using TaskManagerApp.Models
@inject AppDbContext _context
@{
ViewData["Title"] = "Dashboard";
}

<div id="home-view">
    <div class="stats-grid">
        <div class="stat-card stat-success" id="stat-card-productivity">
            <span class="stat-title">HAFTALIK TAMAMLANAN GÖREV</span>
            <span class="stat-value" id="stat-weekly-productivity">0</span>
        </div>
        <div class="stat-card stat-danger" id="stat-card-approaching">
            <span class="stat-title">YAKLAŞAN TESLİMLER</span>
            <span class="stat-value" id="stat-approaching-deadlines" style="font-size: 1.5rem; word-break: break-word;">-</span>
        </div>
        <div class="stat-card stat-error" id="stat-card-overdue">
            <span class="stat-title">GECİKEN PROJELER</span>
            <span class="stat-value" id="stat-overdue-projects" style="font-size: 1.5rem; word-break: break-word;">0</span>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 id="home-view-title" style="font-weight: 700; font-size: 1.4rem; color: var(--text-primary);">Çalışma Alanları</h2>
        <button class="tm-btn tm-btn-primary" onclick="openProjectModal()">+ Yeni Proje</button>
    </div>

    <!-- Search and Filter Bar for Workspaces Grid -->
    <div class="tm-card" style="margin-bottom: 24px; padding: 12px 16px; border: 1px solid var(--border-color); background-color: var(--bg-surface); display: flex; flex-wrap: wrap; gap: 16px; align-items: stretch; justify-content: space-between; border-radius: var(--radius-md);">
        <div style="flex: 1; min-width: 250px; position: relative;">
            <input type="text" id="grid-search" placeholder="Proje başlığı veya açıklaması ara..." class="form-control" style="box-sizing: border-box; padding-left: 36px; font-size: 0.9rem; height: 42px; margin: 0;" />
            <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;">🔍</span>
        </div>
        <div style="display: flex; gap: 8px; align-items: stretch;">
            <select id="grid-sort" class="form-control" style="box-sizing: border-box; font-size: 0.9rem; padding: 0 12px; min-width: 180px; height: 42px; margin: 0;">
                <option value="none">Sıralama Yok</option>
                <option value="closest-deadline">En Yakın Teslim</option>
                <option value="farthest-deadline">En uzak teslim</option>
                <option value="highest-completion">En yüksek tamamlama oranı</option>
                <option value="lowest-completion">En düşük tamamlama oranı</option>
            </select>
            <select id="grid-filter-status" class="form-control" style="box-sizing: border-box; font-size: 0.9rem; padding: 0 12px; min-width: 200px; height: 42px; margin: 0;">
                <option value="all">🔍 Tüm Projeler</option>
                <option value="active">⏳ Sadece Aktif Projeler</option>
                <option value="completed">✅ Sadece Tamamlanan Projeler</option>
                <option value="approaching">🔥 Yaklaşan Teslimler</option>
                <option value="overdue">⚠️ Geciken Projeler</option>
            </select>
            <button id="btn-clear-filters" class="tm-btn tm-btn-secondary" disabled title="Filtreleri Temizle" style="box-sizing: border-box; padding: 0 16px; font-size: 0.9rem; height: 42px; margin: 0; display: flex; align-items: center; justify-content: center;">
                ❌
            </button>
        </div>
    </div>

    <div id="projects-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
    </div>
</div>

<div id="teams-dashboard-view" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="font-weight: 700; font-size: 1.4rem; color: var(--text-primary); display: flex; align-items: center; gap: 10px;">
                👥 Takımlar
            </h2>
            <p style="color: var(--text-secondary); margin-top: 8px; font-size: 0.95rem;">
                Bulunduğunuz takımları yönetin veya yeni bir takıma katılın.
            </p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="tm-btn tm-btn-secondary" onclick="openJoinTeamModal()">+ Takıma Katıl</button>
            <button class="tm-btn tm-btn-primary" onclick="openCreateTeamModal()">+ Yeni Takım Kur</button>
        </div>
    </div>

    <div id="teams-dashboard-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        <!-- Takımlar buraya yüklenecek -->
    </div>
</div>

<div id="workspace-view" style="display: none;">
    <div class="workspace-header">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 12px;">
            <div>
                <h1 id="wp-title" class="workspace-title">Proje Yükleniyor...</h1>
                <p id="wp-desc" style="color: var(--text-secondary); line-height: 1.6; max-width: 800px; margin-bottom: 8px;"></p>
                <div id="wp-dates" style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 16px; display: flex; gap: 16px; align-items: center;"></div>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="tm-btn tm-btn-secondary" id="wp-edit-btn">Düzenle</button>
                <button class="tm-btn tm-btn-danger" id="wp-delete-btn">Sil</button>
            </div>
        </div>

        <div class="progress-container">
            <div class="progress-header">
                <span>Genel Proje İlerlemesi</span>
                <span id="wp-progress-text" style="font-weight: 600;">%0</span>
            </div>
            <div class="progress-bar-bg" style="height: 12px; border-radius: 6px;">
                <div class="progress-bar-fill" id="wp-progress-bar" style="width: 0%;"></div>
            </div>
        </div>

        <div class="workspace-actions">
            <button class="tm-btn tm-btn-success" id="wp-add-maingoal-btn">+ Yeni Ana Hedef Ekle</button>
            <button class="tm-btn tm-btn-primary" id="wp-add-project-task-btn">+ Yeni Görev Ekle</button>
            <button class="tm-btn tm-btn-secondary" onclick="showDashboardHome()">← Panoya Geri Dön</button>
        </div>
    </div>

    <!-- Workspace Tabs -->
    <div class="workspace-tabs" style="display: flex; gap: 16px; margin-top: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 4px;">
        <button id="tab-active-goals" class="workspace-tab-btn active-tab" onclick="switchWorkspaceTab('active')" style="background: none; border: none; border-bottom: 3px solid var(--color-primary); color: var(--text-primary); font-weight: 600; font-size: 0.95rem; cursor: pointer; padding: 8px 16px; transition: all 0.2s;">
            🎯 Aktif Hedefler
        </button>
        <button id="tab-deleted-goals" class="workspace-tab-btn" onclick="switchWorkspaceTab('deleted')" style="background: none; border: none; border-bottom: 3px solid transparent; color: var(--text-secondary); font-weight: 500; font-size: 0.95rem; cursor: pointer; padding: 8px 16px; transition: all 0.2s;">
            🗑️ Silinen Ögeler
        </button>
    </div>

    <!-- Tab Contents -->
    <div id="active-tab-content" style="display: block;">
        <div id="maingoals-list" style="margin-top: 32px;">
        </div>
    </div>

    <div id="deleted-tab-content" style="display: none; margin-top: 32px;">
        <div id="deleted-items-list" class="deleted-items-list" style="display: flex; flex-direction: column; gap: 16px;">
            <!-- Silinen ögeler buraya yüklenecek -->
        </div>
    </div>
</div>

<div id="deleted-view" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="font-weight: 700; font-size: 1.4rem; color: var(--text-primary);">Çöp Kutusu</h2>
        <button class="tm-btn tm-btn-secondary" onclick="showDashboardHome()">← Panoya Geri Dön</button>
    </div>

    <!-- Bulk Operations Toolbar -->
    <div id="trash-bulk-toolbar" style="display: none; justify-content: space-between; align-items: center; background-color: var(--bg-surface-elevated); padding: 12px 20px; border-radius: var(--radius-md); margin-bottom: 20px; border: 1px solid var(--border-color); flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <input type="checkbox" id="select-all-deleted-projects" onchange="toggleSelectAllDeletedProjects(this)" style="width: 18px; height: 18px; cursor: pointer;" />
            <label for="select-all-deleted-projects" style="font-size: 0.9rem; font-weight: 500; cursor: pointer; user-select: none; color: var(--text-primary);">Tümünü Seç</label>
            <span id="selected-projects-count" style="font-size: 0.85rem; color: var(--text-muted); margin-left: 12px; display: none;">0 proje seçildi</span>
        </div>
        <div style="display: flex; gap: 8px;">
            <!-- Bulk Action Buttons -->
            <button class="tm-btn tm-btn-success" id="btn-bulk-restore" onclick="bulkRestoreSelectedProjects()" style="display: none; padding: 6px 14px; font-size: 0.85rem;">Seçilenleri Geri Yükle</button>
            <button class="tm-btn tm-btn-danger" id="btn-bulk-delete" onclick="bulkDeleteSelectedProjects()" style="display: none; padding: 6px 14px; font-size: 0.85rem;">Seçilenleri Kalıcı Sil</button>

            <!-- Global Action Buttons -->
            <button class="tm-btn tm-btn-success" id="btn-all-restore" onclick="restoreAllDeletedProjects()" style="padding: 6px 14px; font-size: 0.85rem;">Tümünü Geri Yükle</button>
            <button class="tm-btn tm-btn-danger" id="btn-all-delete" onclick="deleteAllDeletedProjects()" style="padding: 6px 14px; font-size: 0.85rem;">Tümünü Kalıcı Sil</button>
        </div>
    </div>

    <div id="deleted-projects-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        <!-- Bu alan Javascript ile doldurulacaktır -->
    </div>
</div>

<div id="activities-view" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="font-weight: 700; font-size: 1.4rem; color: var(--text-primary); display: flex; align-items: center; gap: 10px;">
                ⏱️ Son Aktiviteler
            </h2>
            <p style="color: var(--text-secondary); margin-top: 8px; font-size: 0.95rem;">
                Tüm projelerinizdeki son değişikliklerin kaydını buradan takip edebilirsiniz.
            </p>
        </div>
        <button class="tm-btn tm-btn-secondary" onclick="showDashboardHome()">← Panoya Geri Dön</button>
    </div>

    <div id="activities-content-container" style="display: flex; flex-direction: column; gap: 16px;">
        <!-- Veriler buraya yüklenecek -->
    </div>
</div>


<div class="tm-modal-overlay" id="project-modal">
    <div class="tm-modal">
        <div class="tm-modal-header">
            <h3 id="project-modal-title" style="font-weight: 600;">Yeni Proje Ekle</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('project-modal')">✕</button>
        </div>
        <form id="project-form" onsubmit="handleProjectSubmit(event)">
            <input type="hidden" id="project-modal-id" />
            <div class="tm-modal-body">
                <div class="form-group">
                    <label class="form-label" for="project-title">Proje Adı</label>
                    <input type="text" id="project-title" class="form-control" required placeholder="Örn: E-Ticaret Arayüz Tasarımı" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="project-desc">Açıklama</label>
                    <textarea id="project-desc" class="form-control" placeholder="Projenin amacını ve kapsamını açıklayın... (İsteğe bağlı)"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label" for="project-deadline">Teslim Tarihi (İsteğe Bağlı)</label>
                    <input type="date" id="project-deadline" class="form-control" />
                </div>
            </div>
            <div class="tm-modal-footer">
                <button type="button" class="tm-btn tm-btn-secondary" onclick="closeModal('project-modal')">Vazgeç</button>
                <button type="submit" class="tm-btn tm-btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<div class="tm-modal-overlay" id="maingoal-modal">
    <div class="tm-modal">
        <div class="tm-modal-header">
            <h3 id="maingoal-modal-title" style="font-weight: 600;">Yeni Ana Hedef Ekle</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('maingoal-modal')">✕</button>
        </div>
        <form id="maingoal-form" onsubmit="handleMainGoalSubmit(event)">
            <input type="hidden" id="maingoal-modal-id" />
            <input type="hidden" id="maingoal-project-id" />
            <div class="tm-modal-body">
                <div class="form-group">
                    <label class="form-label" for="maingoal-title">Ana Hedef Başlığı</label>
                    <input type="text" id="maingoal-title" class="form-control" required placeholder="Örn: Figma Tasarımlarını Tamamla" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="maingoal-desc">Açıklama</label>
                    <textarea id="maingoal-desc" class="form-control" placeholder="Ana hedefin detaylarını açıklayın... (İsteğe bağlı)"></textarea>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="maingoal-completed" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="maingoal-completed" style="font-size: 0.9rem; user-select: none; cursor: pointer;">Tamamlandı Olarak İşaretle</label>
                </div>
            </div>
            <div class="tm-modal-footer">
                <button type="button" class="tm-btn tm-btn-secondary" onclick="closeModal('maingoal-modal')">Vazgeç</button>
                <button type="submit" class="tm-btn tm-btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<div class="tm-modal-overlay" id="subgoal-modal">
    <div class="tm-modal">
        <div class="tm-modal-header">
            <h3 id="subgoal-modal-title" style="font-weight: 600;">Yeni Alt Hedef Ekle</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('subgoal-modal')">✕</button>
        </div>
        <form id="subgoal-form" onsubmit="handleSubGoalSubmit(event)">
            <input type="hidden" id="subgoal-modal-id" />
            <input type="hidden" id="subgoal-maingoal-id" />
            <input type="hidden" id="subgoal-project-id" />
            <div class="tm-modal-body">
                <div class="form-group">
                    <label class="form-label" for="subgoal-title">Alt Hedef Başlığı</label>
                    <input type="text" id="subgoal-title" class="form-control" required placeholder="Örn: Mobil Arayüz Eskizleri" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="subgoal-desc">Açıklama</label>
                    <textarea id="subgoal-desc" class="form-control" placeholder="Alt hedefin detaylarını açıklayın... (İsteğe bağlı)"></textarea>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="subgoal-completed" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="subgoal-completed" style="font-size: 0.9rem; user-select: none; cursor: pointer;">Tamamlandı Olarak İşaretle</label>
                </div>
            </div>
            <div class="tm-modal-footer">
                <button type="button" class="tm-btn tm-btn-secondary" onclick="closeModal('subgoal-modal')">Vazgeç</button>
                <button type="submit" class="tm-btn tm-btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<div class="tm-modal-overlay" id="task-modal">
    <div class="tm-modal">
        <div class="tm-modal-header">
            <h3 id="task-modal-title" style="font-weight: 600;">Yeni Görev Ekle</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('task-modal')">✕</button>
        </div>
        <form id="task-form" onsubmit="handleTaskSubmit(event)">
            <input type="hidden" id="task-modal-id" />
            <input type="hidden" id="task-subgoal-id" />
            <input type="hidden" id="task-maingoal-id" />
            <input type="hidden" id="task-project-id" />
            <div class="tm-modal-body">
                <div class="form-group">
                    <label class="form-label" for="task-title">Görev Başlığı</label>
                    <input type="text" id="task-title" class="form-control" required placeholder="Örn: Buton Durumları Tasarla" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="task-desc">Açıklama</label>
                    <textarea id="task-desc" class="form-control" placeholder="Görevin detaylarını açıklayın... (İsteğe bağlı)"></textarea>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="task-completed" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="task-completed" style="font-size: 0.9rem; user-select: none; cursor: pointer;">Tamamlandı Olarak İşaretle</label>
                </div>
            </div>
            <div class="tm-modal-footer">
                <button type="button" class="tm-btn tm-btn-secondary" onclick="closeModal('task-modal')">Vazgeç</button>
                <button type="submit" class="tm-btn tm-btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<div class="tm-modal-overlay" id="delete-modal">
    <div class="tm-modal" style="max-width: 400px;">
        <div class="tm-modal-header" style="background-color: var(--color-danger-glow);">
            <h3 style="font-weight: 600; color: var(--color-danger);">Ögeyi Sil?</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('delete-modal')">✕</button>
        </div>
        <div class="tm-modal-body">
            <p style="color: var(--text-secondary); line-height: 1.5;" id="delete-message">Bu ögeyi ve altındaki tüm alt ögeleri silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
        </div>
        <div class="tm-modal-footer">
            <button type="button" class="tm-btn tm-btn-secondary" onclick="closeModal('delete-modal')">Vazgeç</button>
            <button type="button" class="tm-btn tm-btn-danger" id="delete-confirm-btn">Evet, Sil</button>
        </div>
    </div>
</div>

<div class="tm-modal-overlay" id="create-team-modal">
    <div class="tm-modal">
        <div class="tm-modal-header">
            <h3 style="font-weight: 600;">Yeni Takım Kur</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('create-team-modal')">✕</button>
        </div>
        <form id="create-team-form" onsubmit="handleCreateTeamSubmit(event)">
            <div class="tm-modal-body">
                <div class="form-group">
                    <label class="form-label" for="team-name">Takım Adı</label>
                    <input type="text" id="team-name" class="form-control" required placeholder="Örn: Ar-Ge Takımı" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="team-desc">Açıklama</label>
                    <textarea id="team-desc" class="form-control" placeholder="Takımın amacı ve kapsamı... (İsteğe bağlı)"></textarea>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="team-is-open" checked />
                    <label for="team-is-open" style="font-size: 0.9rem; user-select: none; cursor: pointer;">Takım katılıma açık olsun (Kapalı takımlara katılım onaya tabidir)</label>
                </div>
            </div>
            <div class="tm-modal-footer">
                <button type="button" class="tm-btn tm-btn-secondary" onclick="closeModal('create-team-modal')">Vazgeç</button>
                <button type="submit" class="tm-btn tm-btn-primary">Kur</button>
            </div>
        </form>
    </div>
</div>

<div class="tm-modal-overlay" id="join-team-modal">
    <div class="tm-modal">
        <div class="tm-modal-header">
            <h3 style="font-weight: 600;">Takıma Katıl</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('join-team-modal')">✕</button>
        </div>
        <form id="join-team-form" onsubmit="handleJoinTeamSubmit(event)">
            <div class="tm-modal-body">
                <div class="form-group">
                    <label class="form-label" for="join-team-id">Takım ID (Grup ID)</label>
                    <input type="number" id="join-team-id" class="form-control" required placeholder="Katılmak istediğiniz takımın ID'sini girin" />
                </div>
            </div>
            <div class="tm-modal-footer">
                <button type="button" class="tm-btn tm-btn-secondary" onclick="closeModal('join-team-modal')">Vazgeç</button>
                <button type="submit" class="tm-btn tm-btn-primary">Katıl</button>
            </div>
        </form>
    </div>
</div>

<div class="tm-modal-overlay" id="manage-team-modal">
    <div class="tm-modal" style="max-width: 600px;">
        <div class="tm-modal-header">
            <h3 style="font-weight: 600;">Takım Yönetimi</h3>
            <button class="tm-btn-icon-only" onclick="closeModal('manage-team-modal')">✕</button>
        </div>
        <div class="tm-modal-body">
            <input type="hidden" id="manage-team-id" />
            <div style="display: flex; gap: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                <button class="tm-btn tm-btn-secondary" onclick="switchManageTab('members')" id="tab-members">Üyeler</button>
                <button class="tm-btn tm-btn-secondary" onclick="switchManageTab('requests')" id="tab-requests">Katılım İstekleri <span id="requests-badge" style="display:none; background:var(--color-danger); color:white; border-radius:50%; padding:2px 6px; font-size:0.75rem;"></span></button>
            </div>
            
            <div id="manage-content-members">
                <div id="members-list" style="display: flex; flex-direction: column; gap: 8px; max-height: 300px; overflow-y: auto;">
                    Yükleniyor...
                </div>
            </div>

            <div id="manage-content-requests" style="display: none;">
                <div id="requests-list" style="display: flex; flex-direction: column; gap: 8px; max-height: 300px; overflow-y: auto;">
                    Yükleniyor...
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/dashboard.js"></script>

