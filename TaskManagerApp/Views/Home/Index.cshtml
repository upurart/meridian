</div>

<!-- Chat Context Menu -->
<div id="chat-context-menu" style="display: none; position: fixed; background: var(--bg-surface-elevated); border: 1px solid var(--border-color); border-radius: var(--radius-md); box-shadow: var(--shadow-md); z-index: 2000; padding: 4px; min-width: 140px;">
    <button class="chat-ctx-btn" onclick="handleChatAction('forward')"><i class="bi bi-share"></i> İlet</button>
