@model TaskManagerApp.Models.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TaskManagerApp - Yeni Şifre Belirle</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">TaskManager</div>
            <div class="auth-subtitle">Lütfen yeni şifrenizi belirleyin.</div>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                }

                <div class="form-group">
                    <label class="form-label" asp-for="NewPassword">Yeni Şifre</label>
                    <input type="password" asp-for="NewPassword" class="form-control" placeholder="••••••••" required autofocus />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="ConfirmPassword">Yeni Şifre (Tekrar)</label>
                    <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="auth-btn">Şifreyi Güncelle</button>
            </form>
        </div>
    </div>
</body>
</html>
