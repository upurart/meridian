@model TaskManagerApp.Models.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TaskManagerApp - Şifremi Unuttum</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">TaskManager</div>
            <div class="auth-subtitle">Şifrenizi sıfırlamak için e-posta adresinizi girin.</div>

            <form asp-action="ForgotPassword" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                }

                <div class="form-group">
                    <label class="form-label" asp-for="Email">E-posta</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="ornek@email.com" required autofocus />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <button type="submit" class="auth-btn">Şifre Sıfırlama Bağlantısı Gönder</button>
            </form>

            <div class="auth-footer" style="margin-top: 20px;">
                <a asp-action="Login">Giriş Ekranına Dön</a>
            </div>
        </div>
    </div>
</body>
</html>
