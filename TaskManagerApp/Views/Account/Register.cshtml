@model TaskManagerApp.Controllers.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TaskManagerApp - Kayıt Ol</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">TaskManager</div>
            <div class="auth-subtitle">Yeni bir hesap oluşturun ve yönetmeye başlayın</div>

            <form asp-action="Register" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                }

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" asp-for="Name">Adı</label>
                        <input type="text" asp-for="Name" class="form-control" placeholder="Örn: Uğur" required />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Surname">Soyadı</label>
                        <input type="text" asp-for="Surname" class="form-control" placeholder="Örn: Güler" required />
                        <span asp-validation-for="Surname" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Username">Kullanıcı Adı</label>
                    <input type="text" asp-for="Username" class="form-control" placeholder="kullaniciadi" required autocomplete="username" />
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Email">E-posta</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="ornek@alanadi.com" required autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" asp-for="Password">Şifre</label>
                        <input type="password" asp-for="Password" class="form-control" placeholder="••••••••" required autocomplete="new-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="ConfirmPassword">Şifre Tekrar</label>
                        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                </div>

                <button type="submit" class="auth-btn">Kayıt Ol</button>
            </form>

            <div class="auth-footer">
                Zaten hesabınız var mı? <a asp-action="Login">Giriş Yapın</a>
            </div>
        </div>
    </div>
</body>
</html>
