@model IEnumerable<TaskManagerApp.Models.TaskItem>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="margin: 0; color: var(--text-main);">Görevler</h2>
    <a asp-action="Create" asp-route-subGoalId="@ViewBag.SubGoalId" class="tm-btn tm-btn-success">+ Yeni Görev Ekle</a>
</div>

<div class="row">
    @foreach (var task in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="tm-card @(task.IsCompleted ? "task-completed" : "")">
                <h3>@task.Title</h3>
                <p>@task.Description</p>
                <p style="color: var(--text-muted); font-size: 0.85rem;">
                    <strong>Durum:</strong> @Html.Raw(task.IsCompleted ? "<i class='bi bi-check-circle-fill text-success'></i> Tamamlandı" : "<i class='bi bi-hourglass-split text-warning'></i> Devam Ediyor")
                </p>

                <div class="tm-actions" style="margin-top: 20px;">
                    <a asp-action="Edit" asp-route-id="@task.Id" class="tm-btn tm-btn-warning" style="flex: 1;">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@task.Id" class="tm-btn tm-btn-danger">Sil</a>
                </div>
            </div>
        </div>
    }
</div>

<div style="margin-top: 20px;">
    <a asp-controller="Project" asp-action="Index" class="tm-btn" style="background-color: #333; color: var(--text-main);">Tüm Projelere Geri Dön</a>
</div>