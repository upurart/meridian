@model TaskManagerApp.Models.TaskItem

<h2 style="color: red;">Görevi Sil</h2>
<p>Bu görevi silmek istediğinize emin misiniz?</p>

<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 15px;">
    <h3>@Model.Title</h3>
    <p>@Model.Description</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" style="padding: 10px 20px; background-color: red; color: white; border: none; cursor: pointer;">
        Evet, Kalıcı Olarak Sil
    </button>
</form>

<div style="margin-top: 15px;">
    <a asp-action="Index" asp-route-subGoalId="@Model.SubGoalId">Vazgeç ve Listeye Dön</a>
</div>